<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <permission
        android:name="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT"
        android:description="@string/permdesc_displayConnect"
        android:label="@string/permlab_displayConnect"
        android:protectionLevel="signature" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.dalton.braillekeyboard.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PreferenceIME"
            android:exported="false"
            android:label="@string/settings_name" />

        <activity
            android:name=".IntentActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="com.dalton.braillekeyboard.BrailleDisplayActivity"
            android:exported="false"
            android:label="@string/braille_displays_title" />

        <activity
            android:name=".QuickStartActivity"
            android:exported="false"
            android:label="@string/quick_start_title" />

        <activity
            android:name=".SupportReportActivity"
            android:exported="false"
            android:label="@string/report_issue_title" />

        <service
            android:name="com.dalton.braillekeyboard.BrailleIME"
            android:exported="true"
            android:label="@string/braille_ime"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <service
            android:name="com.googlecode.eyesfree.braille.service.translate.TranslatorService"
            android:enabled="true"
            android:exported="false" >
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_TRANSLATOR_SERVICE" />
            </intent-filter>
        </service>

        <service
            android:name="com.dalton.braillekeyboard.BrailleAccessibilityService"
            android:description="@string/braille_accessibility_service_description"
            android:enabled="true"
            android:exported="false"
            android:label="@string/braille_displays_title"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/braille_accessibility_service" />
        </service>

        <service
            android:name="com.googlecode.eyesfree.braille.service.display.DisplayService"
            android:enabled="true"
            android:exported="false"
            android:permission="com.googlecode.eyesfree.braille.display.PERMISSION_CONNECT" >
            <intent-filter>
                <action android:name="com.googlecode.eyesfree.braille.service.ACTION_DISPLAY_SERVICE" />
            </intent-filter>
        </service>
    </application>

</manifest>
