<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/braille_displays_intro" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:onClick="onBluetoothSettings"
            android:text="@string/braille_open_bluetooth_settings" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onAccessibilitySettings"
            android:text="@string/braille_open_accessibility_settings" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onRequestUsbPermission"
            android:text="@string/braille_request_usb_permission" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onRefreshDisplays"
            android:text="@string/braille_refresh" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onReconnectDisplays"
            android:text="@string/braille_reconnect" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onSendTestPattern"
            android:text="@string/braille_send_test_pattern" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_accessibility"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_profiles"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_profile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/braille_section_named_profiles"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/braille_named_profiles_intro" />

        <TextView
            android:id="@+id/braille_named_profile_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textIsSelectable="true" />

        <EditText
            android:id="@+id/braille_named_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/braille_named_profiles_name_hint"
            android:inputType="textCapWords" />

        <Spinner
            android:id="@+id/braille_named_profile_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onSaveNamedBrailleProfile"
            android:text="@string/braille_named_profiles_save_current" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onApplyNamedBrailleProfile"
            android:text="@string/braille_named_profiles_apply_selected" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onCycleNamedBrailleProfile"
            android:text="@string/braille_named_profiles_next" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onDeleteNamedBrailleProfile"
            android:text="@string/braille_named_profiles_delete_selected" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onCyclePreferredDisplay"
            android:text="@string/braille_cycle_preferred_display" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onClearPreferredDisplay"
            android:text="@string/braille_clear_preferred_display" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onCycleDeviceProfileTable"
            android:text="@string/braille_cycle_profile_table" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onClearDeviceProfileTable"
            android:text="@string/braille_clear_profile_table" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onExportBrailleProfiles"
            android:text="@string/braille_export_profiles" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onImportBrailleProfiles"
            android:text="@string/braille_import_profiles" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onShareBrailleProfiles"
            android:text="@string/braille_share_profiles" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onExportBrailleProfilesToFile"
            android:text="@string/braille_export_profiles_file" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onImportBrailleProfilesFromFile"
            android:text="@string/braille_import_profiles_file" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_remap"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_remap_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onCycleRemapBinding"
            android:text="@string/braille_cycle_remap_binding" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onCycleRemapCommand"
            android:text="@string/braille_cycle_remap_command" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onClearRemapCommand"
            android:text="@string/braille_clear_remap_command" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_command_test"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_command_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_content_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onClearBrailleLog"
            android:text="@string/braille_clear_log" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onCopyBrailleDiagnostics"
            android:text="@string/braille_copy_diagnostics" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onExportBrailleDiagnostics"
            android:text="@string/braille_export_diagnostics" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onReportBrailleIssue"
            android:text="@string/button_report_braille_issue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_status"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/braille_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_devices"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_properties"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_properties"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_section_log"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/braille_event_log"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#11000000"
            android:gravity="top|start"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
