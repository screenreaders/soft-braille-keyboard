<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/braille_keyboard_test_intro" />

        <TextView
            android:id="@+id/braille_keyboard_test_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/main_status_loading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/braille_keyboard_test_calibration_steps"
            android:textStyle="bold" />

        <Button
            style="@android:style/TextAppearance.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:onClick="onOpenKeyboardSettings"
            android:text="@string/button_keyboard_settings" />

        <Button
            style="@android:style/TextAppearance.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onChooseDefaultKeyboard"
            android:text="@string/button_choose_default_keyboard" />

        <Button
            style="@android:style/TextAppearance.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:onClick="onFocusPracticeField"
            android:text="@string/button_braille_keyboard_test_focus" />

        <EditText
            android:id="@+id/braille_keyboard_test_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="top|start"
            android:hint="@string/try_box"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="5" />

        <Button
            style="@android:style/TextAppearance.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:onClick="onDone"
            android:text="@string/setup_finish_button" />

    </LinearLayout>
</ScrollView>
