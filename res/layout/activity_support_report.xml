<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_issue_intro" />

        <TextView
            android:id="@+id/report_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/report_issue_github_only" />

        <EditText
            android:id="@+id/report_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/report_issue_subject_hint"
            android:inputType="textCapSentences"
            android:maxLines="2" />

        <EditText
            android:id="@+id/report_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
            android:hint="@string/report_issue_message_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="5" />

        <EditText
            android:id="@+id/report_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/report_issue_name_hint"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/report_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/report_issue_email_hint"
            android:inputType="textEmailAddress" />

        <CheckBox
            android:id="@+id/report_include_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/report_issue_include_diagnostics" />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:onClick="onSendReport"
            android:text="@string/report_issue_send" />
    </LinearLayout>
</ScrollView>
